{
  "name": "foodonthego",
  "version": "0.1.0",
  "private": true,
  "description": "FoodOnTheGo - restaurant discovery, ordering and delivery tracking",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:api": "npm run dev --workspace @fotg/api",
    "dev:web": "npm run dev --workspace @fotg/web",
    "seed": "npm run seed --workspace @fotg/api"
  }
}
