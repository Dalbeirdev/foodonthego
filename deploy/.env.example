# FoodOnTheGo — review deployment. Copy to deploy/.env and fill in.
#
# THIS FILE IS AN EXAMPLE AND CONTAINS NO REAL SECRETS. deploy/.env is
# gitignored and must never be committed.

# ---------------------------------------------------------------------------
# APP_ENV — read this before changing it.
#
# `review` is not `production`, and that is the point. ProductionConfigGuard
# runs only in staging and production, and it refuses to boot without a real
# SMS vendor, Google Places, Google Routes and Razorpay credentials. None of
# those exist for this project, so APP_ENV=production would not start at all.
#
# Running as `review` means the guard stands aside and the development
# providers are used instead. What that actually costs is listed in
# deploy/README.md under "What this deployment is not". Read it before showing
# the result to anybody, because one of the items is that routes are straight
# lines rather than roads.
#
# When real credentials arrive: set APP_ENV=production, fill in the provider
# blocks below, and the guard will tell you at boot if anything is missing.
# ---------------------------------------------------------------------------
APP_NAME=FoodOnTheGo
APP_ENV=review
APP_DEBUG=false
APP_URL=https://techpio.tech

# php artisan key:generate --show
APP_KEY=

# Exact origins, no wildcard.
FRONTEND_URLS=https://techpio.tech

# --- database ---------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=foodonthego
DB_USERNAME=foodonthego
# Generate both: openssl rand -base64 24
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- cache, queue, session --------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# --- one-time passcodes -----------------------------------------------------
# `log` writes codes to storage/logs. Anybody who can read that file can sign
# in as any customer who has requested one, so this is for a review box with
# test data and nothing else. It refuses to run in production on its own
# account.
OTP_PROVIDER=log

# --- places and routing -----------------------------------------------------
# `development` is a small fixed gazetteer and straight-line routing. Fine for
# a demo, wrong for anything a person would act on.
PLACES_PROVIDER=development
ROUTE_PROVIDER=development

# GOOGLE_MAPS_API_KEY=
# PLACES_PROVIDER=google
# ROUTE_PROVIDER=google

# --- payment ----------------------------------------------------------------
# Left empty deliberately. Empty means UnconfiguredPaymentGateway, which
# refuses every call — the correct behaviour when no credentials exist. Do not
# invent values here to make a screen look finished.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
