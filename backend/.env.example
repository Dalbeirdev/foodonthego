# FoodOnTheGo — backend environment template.
#
# Copy to .env and fill in. NOTHING in this file is a real credential, and no real
# credential is ever committed: see docs/07-security.md.

APP_NAME=FoodOnTheGo
APP_ENV=local                       # local | development | staging | production
APP_KEY=
APP_DEBUG=true                      # MUST be false outside local/development
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

# Comma-separated exact origins. No wildcard once APP_ENV is staging/production.
FRONTEND_URLS=http://localhost:5173,http://localhost:5174

LOG_CHANNEL=stack
LOG_STACK=structured
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=foodonthego_local
DB_USERNAME=fotg
DB_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Redis is cache/queue/locks/rate-limit only. MySQL stays the source of truth for
# orders, payments, refunds and payouts — see docs/02-architecture.md.
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# Requests per minute, per authenticated user or per IP when anonymous.
RATE_LIMIT_PUBLIC=60
RATE_LIMIT_AUTHENTICATED=120

# Per IP, per minute, on the unauthenticated auth endpoints. Deliberately far
# below the public allowance: a genuine sign-in needs a handful of requests.
RATE_LIMIT_AUTH_OTP=10
RATE_LIMIT_AUTH_VERIFY=15

# How long a replayed Idempotency-Key stays valid, in seconds.
IDEMPOTENCY_TTL=86400

# --- One-time passcodes (docs/18-customer-authentication.md) ----------------
#
# OTP_PROVIDER=log writes codes to storage/logs/otp-development.log so the flow
# can be completed without an SMS gateway. It is a DEVELOPMENT-ONLY value:
# LogOtpProvider throws if the environment is production, and the production
# config guard refuses to boot on any sender that cannot reach a real handset.
# Leaving this unset in production yields a sender that fails loudly.
OTP_PROVIDER=log

OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_REQUESTS_PER_PHONE=5
OTP_MAX_REQUESTS_PER_IP=20
OTP_REQUEST_WINDOW_SECONDS=3600

# How long a verified phone can be exchanged for an account.
OTP_REGISTRATION_TOKEN_TTL_SECONDS=900

# Development switch for exercising the delivery-failure path end to end.
# The production guard refuses to boot while this is true.
OTP_SIMULATE_PROVIDER_FAILURE=false

# Sanctum access-token lifetime. 30 days: long enough that a traveller is not
# signed out mid-journey, short enough that a lost handset stops working.
AUTH_TOKEN_TTL_SECONDS=2592000

# Observability. Empty disables the integration rather than failing.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Places (Module 05) ---
#
# Place search is server-mediated: this key never ships to a device. A Places key
# in a mobile binary is a published key, and Google's platform restrictions bound
# the damage rather than preventing it. Held here it is IP-restricted to your
# servers and rotatable without an app release.
#
#   unconfigured  the default; every place call fails and the app says so.
#                 A production boot refuses to start on it.
#   development   a small fixed gazetteer of real places, for local work.
#                 Refuses to be constructed in production.
#   google        Google Places API (New) + Geocoding, needs the key below.
#
# Restrict the key to the Places API (New) and the Geocoding API, and to your
# servers' egress IPs. Do not add Android/iOS restrictions — the app never uses it.
PLACES_PROVIDER=development
# GOOGLE_PLACES_API_KEY=
# A search bias, not a filter. Comma-separated ISO-3166-1 alpha-2 codes.
PLACES_REGIONS=in

# --- Routing (Module 06) ----------------------------------------------------
#
# 'google' in any real deployment. 'development' is a straight-line stand-in
# that refuses to run in production and labels everything it returns;
# 'unconfigured' is the default and fails loudly. A production application
# configured to anything but a real provider refuses to boot.
ROUTE_PROVIDER=unconfigured

# A SERVER key, and deliberately not the same one as GOOGLE_PLACES_API_KEY:
# the two carry different API restrictions and are rotated independently. It
# never leaves the backend — the app has no routing key of any kind.
#
# Restrict it before it is ever used:
#   Application restriction : IP addresses — the backend's egress addresses only
#   API restriction         : Routes API, and nothing else
#   Android / iOS restriction: not applicable; the app never calls this API
#
# The Maps SDK keys the app *does* ship are separate again, and are restricted
# by Android package + signing certificate and by iOS bundle id. See
# docs/21-maps-and-routing.md.
# GOOGLE_ROUTES_API_KEY=

# Road travel. Not customer-facing.
ROUTE_TRAVEL_MODE=DRIVE

# Each alternative costs the same as the primary route, so this is a product
# decision with an invoice attached.
ROUTE_ALTERNATIVES_ENABLED=true
ROUTE_MAX_ALTERNATIVES=3

# Traffic-aware routing costs more than traffic-unaware, and a travel time that
# ignores traffic is not much use to somebody deciding when to eat.
ROUTE_TRAFFIC_AWARE=true

ROUTE_TIMEOUT_SECONDS=12
ROUTE_LANGUAGE_CODE=en-IN

# How long a calculated route is served without asking the provider again. The
# single most important cost control in this module: without it, every open of
# the route screen is a billed request.
ROUTE_FRESHNESS_SECONDS=900

ROUTE_MAX_POLYLINE_BYTES=512000
ROUTE_ENDPOINT_TOLERANCE_METRES=5000
